# Copy to .env for local development. None of these are secrets (ADR 0028).
# Workload identity federation: the agent's AWS role is exchanged for a short-lived Claude token.
AWS_PROFILE=wms-ops-agent
AWS_REGION=us-east-1
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
WMS_API_URL=http://localhost:8080
AGENT_MODEL=claude-haiku-4-5-20251001
AGENT_DAILY_BUDGET_USD=2.0
AGENT_MAX_TOOL_CALLS=6
# Must match wms-core. The dev profile's defaults are below.
AGENT_TOKEN=dev-agent-token
DEMO_PASSCODE=dev-supervisor
